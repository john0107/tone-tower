{
  "name": "tone-tower",
  "private": true,
  "license": "MIT",
  "engines": {
    "node": ">=22"
  },
  "type": "module",
  "scripts": {
    "catalog": "node tools/catalog/build.mjs",
    "prestart": "npm run catalog",
    "start": "node tools/server/serve.mjs",
    "build": "node tools/publishing/build.mjs",
    "preview": "node tools/server/serve.mjs --dist",
    "check:dist": "node tools/publishing/check.mjs",
    "test": "node --test tests/game/*.test.js",
    "test:tooling": "node --test tests/tooling/*.test.js",
    "test:all": "node --test tests/game/*.test.js tests/tooling/*.test.js",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "audio:download": "node tools/audio/download.mjs",
    "audio:download:mandarin": "node tools/audio/collection-cli.mjs download --collection cmn",
    "audio:status:mandarin": "node tools/audio/collection-cli.mjs status --collection cmn",
    "audio:discover": "node tools/audio/discover.mjs",
    "audio:select": "node tools/audio/select.mjs",
    "audio:import": "node tools/audio/import-curated.mjs",
    "audio:verify": "node tools/audio/verify.mjs",
    "audio:sync": "node tools/catalog/sync.mjs",
    "audio:metadata": "node tools/catalog/metadata.mjs",
    "audio:status": "node tools/audio/status.mjs",
    "audio:export": "node tools/audio/import-curated.mjs --export-only",
    "test:browser": "playwright test",
    "mandarin:dictionary": "node tools/content/mandarin-cli.mjs dictionary",
    "mandarin:review": "node tools/content/mandarin-cli.mjs review",
    "mandarin:import-review": "node tools/content/mandarin-cli.mjs import-review",
    "mandarin:status": "node tools/content/mandarin-cli.mjs status",
    "mandarin:correct": "node tools/content/mandarin-cli.mjs correct"
  },
  "devDependencies": {
    "@playwright/test": "^1.65.0",
    "prettier": "3.9.10"
  }
}
